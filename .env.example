# Optional token for public GitHub API reads. Never commit a real token.
GITHUB_TOKEN=

# Plans are immutable files on the machine running this MCP server.
# Production defaults to the OS temp directory when this setting is absent.
# In cloud settings use /tmp/issuesprint/plans or a writable persistent mount.
# Mount persistent storage in production or retain returned Markdown.
ISSUESPRINT_PLAN_DIR=./data/plans
ISSUESPRINT_ALLOW_SAVE=true

# Local Studio connection
NODE_ENV=development
MCP_TRANSPORT_TYPE=stdio
NITRO_LOG_LEVEL=info

# Compatible initialize handshake for NitroStudio and standard MCP SDK v1 clients.
# This matches the application default; explicit environment settings take precedence.
NITRO_MCP_PROTOCOL_VERSION=legacy

# For an HTTP deployment use:
# NODE_ENV=production
# MCP_TRANSPORT_TYPE=http
# PORT=3000
# HOST=0.0.0.0
# Modern/auto mode is optional; verify client compatibility before selecting it.
