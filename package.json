{
  "name": "issuesprint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An MCP server for choosing GitHub issues and preparing work plans",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/widgets/tsconfig.json",
    "test": "tsc && node --test --test-force-exit tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "build:cloud": "npm ci --include=dev && npm ci --prefix src/widgets --include=dev && npm run build",
    "pack:deployment": "nitrostack-pack --no-sync-gitignore --output issuesprint-deployment.zip"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@nitrostack/core": "^1.1.2",
    "dotenv": "^16.3.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nitrostack/cli": "^1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.3.3"
  },
  "author": "dell",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  },
  "engines": {
    "node": "^20.20.0 || >=22.22.0"
  },
  "license": "MIT"
}
